# Copie para .env e preencha. NUNCA versione o .env.
#
# Estas duas são públicas por natureza: a anon key é protegida pela RLS do banco.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# O Access Token do Mercado Pago NÃO entra aqui. Ele vive só nas Edge Functions:
#   supabase secrets set MP_ACCESS_TOKEN=...
